{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es2018",
    "allowJs": true,
    "importHelpers": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "dom",
      "es5",
      "es2020"
    ],
    "types": [
      "@obsidian-typings/obsidian-public-latest",
      "node"
    ],
    "paths": {
      "src/*": ["./src/*"]
    },
  },
  "include": [
    "**/*.ts",
    "src/types",
    "webpack.config.mts"
  ],
  "exclude": [
    "node_modules/"
  ]
}
